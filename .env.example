# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.
#
# In production (Vercel), these are set as Environment Variables in the
# project dashboard instead — most are added automatically when you connect
# the storage integrations described below.

PORT=3001
NODE_ENV=development

# A long, random string used to sign the admin login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# From the Redis integration (Vercel dashboard > Storage tab > Create
# Database > Redis). Stores the gallery list and category list.
REDIS_URL=

# From a Vercel Blob store (Vercel dashboard > Storage tab). Stores uploaded
# photos. Optional for local dev — without it the server still runs, but
# uploading/deleting a photo will fail until this is set. For local dev,
# run `vercel env pull` after connecting both stores to your project to
# fill in these values at once.
BLOB_READ_WRITE_TOKEN=

# Fixed admin login credentials. Set these to whatever you want the admin
# username/password to be — in production, set them as Environment
# Variables in the Vercel dashboard (never commit real values here).
ADMIN_USERNAME=
ADMIN_PASSWORD=
