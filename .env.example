# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.
#
# In production (Vercel), these are set as Environment Variables in the
# project dashboard instead — most are added automatically when you connect
# the storage integrations described below.

PORT=3001
NODE_ENV=development

# A long, random string used to sign the admin login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# From the "Upstash for Redis" integration (Vercel dashboard > Storage tab).
# Stores the admin credentials and the gallery list.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# From a Vercel Blob store (Vercel dashboard > Storage tab). Stores uploaded
# photos. For local dev, run `vercel env pull` after connecting both stores
# to your project to fill in all four of these values at once.
BLOB_READ_WRITE_TOKEN=

# No admin account exists until you create one — run this once locally
# (with the vars above set): node scripts/set-admin-password.js
